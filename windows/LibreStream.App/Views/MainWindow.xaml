<Window
    x:Class="LibreStream.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LibreStream.App"
    xmlns:core="using:LibreStream.Core"
    Title="Nsound">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RequestedTheme="Dark" Background="{StaticResource NsBgBrush}">
        <Grid.Resources>
            <!-- Botón redondo de icono (barra inferior y pantalla «Reproduciendo») -->
            <Style x:Key="BarIcon" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <!-- Título de cada sección -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="8,14,0,2" />
            </Style>

            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!-- Tarjeta apaisada (vídeo) -->
            <DataTemplate x:Key="VideoCard" x:DataType="local:MediaCard">
                <Button Style="{StaticResource CardButton}" Tag="{x:Bind}" Click="Card_Click" RightTapped="Card_RightTapped" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                    <StackPanel Width="256" Spacing="6">
                        <Grid Height="144" CornerRadius="14" Background="{x:Bind Tile}">
                            <TextBlock Text="{x:Bind Initials}" FontSize="40" FontWeight="Bold" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{x:Bind Artwork}" Stretch="UniformToFill" />
                            <Border x:Name="HoverPlay" Opacity="0" Background="#59000000" IsHitTestVisible="False">
                                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.18" /></Border.OpacityTransition>
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource NsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;" FontSize="20" Margin="3,0,0,0" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Border>
                            <Border Background="#B0000000" CornerRadius="6" Padding="6,2" Margin="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind DurationText}" FontSize="12" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>

            <!-- Tarjeta cuadrada (música) -->
            <DataTemplate x:Key="TrackCard" x:DataType="local:MediaCard">
                <Button Style="{StaticResource CardButton}" Tag="{x:Bind}" Click="Card_Click" RightTapped="Card_RightTapped" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                    <StackPanel Width="160" Spacing="6">
                        <Grid Height="160" CornerRadius="14" Background="{x:Bind Tile}">
                            <TextBlock Text="{x:Bind Initials}" FontSize="44" FontWeight="Bold" Opacity="0.9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{x:Bind Artwork}" Stretch="UniformToFill" />
                            <Border x:Name="HoverPlay" Opacity="0" Background="#40000000" IsHitTestVisible="False">
                                <Border.OpacityTransition><ScalarTransition Duration="0:0:0.18" /></Border.OpacityTransition>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource NsAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                                    <FontIcon Glyph="&#xE768;" FontSize="17" Margin="2,0,0,0" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>

            <!-- Tarjeta de álbum o artista de YouTube Music -->
            <DataTemplate x:Key="EntryCard" x:DataType="local:MusicEntry">
                <Button Style="{StaticResource CardButton}" Tag="{x:Bind}" Click="Entry_Click">
                    <StackPanel Width="160" Spacing="6">
                        <Grid Height="160" Width="160" CornerRadius="{x:Bind Corner}" Background="{x:Bind Tile}">
                            <TextBlock Text="{x:Bind Initials}" FontSize="44" FontWeight="Bold" Opacity="0.9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{x:Bind Artwork}" Stretch="UniformToFill" />
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brillo ambiental: cambia de color con cada canción -->
        <Rectangle x:Name="Ambient" Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0.3,0.7">
                    <GradientStop x:Name="AmbientStop" Color="#4DFF4D62" Offset="0" />
                    <GradientStop x:Name="AmbientEnd" Color="#00FF4D62" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="AmbientBlue" Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0.6,0.35">
                    <GradientStop x:Name="AmbientBlueStop" Color="#333B82F6" Offset="0" />
                    <GradientStop x:Name="AmbientBlueEnd" Color="#003B82F6" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Barra de título -->
        <Grid x:Name="TitleBar">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/icon-64.png" Width="18" Height="18" />
                <TextBlock Text="Nsound" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Navegación + contenido -->
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
                        SelectionChanged="Nav_SelectionChanged" ItemInvoked="Nav_ItemInvoked">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="Search" PlaceholderText="Buscar" QueryIcon="Find" TextChanged="Search_TextChanged" QuerySubmitted="Search_QuerySubmitted" />
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Inicio" Icon="Home" Tag="all" IsSelected="True" />
                <NavigationViewItem Content="Música" Icon="Audio" Tag="track" />
                <NavigationViewItem Content="Vídeos" Icon="Video" Tag="video" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Mi biblioteca" Icon="Library" Tag="library" />
                <NavigationViewItem Content="Descargas" Icon="Download" Tag="downloads" />
                <NavigationViewItem Content="Tu semana" Tag="week">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Tus listas" />
                <NavigationViewItem x:Name="NewListItem" Content="Nueva lista" Icon="Add" Tag="newlist" SelectsOnInvoked="False" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ajustes" Icon="Setting" Tag="settings" />
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Letra sincronizada (LRCLIB) -->
                <Grid x:Name="LyricsPanel" Grid.Column="1" Width="340" Padding="16,20,12,12" RowSpacing="8"
                      Background="{StaticResource NsPanelBrush}" BorderBrush="{StaticResource NsLineBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Letra" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="LyricsInfo" Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" />
                    <ListView x:Name="LyricsList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Lyrics_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:LyricLine">
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,6" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ScrollViewer x:Name="Browse" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28" Spacing="14">

                        <TextBlock x:Name="PageTitle" Text="Inicio" FontSize="36" FontWeight="Bold" Margin="8,0,0,0" />
                        <TextBlock x:Name="PageHint" Opacity="0.7" Margin="8,-8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                        <StackPanel x:Name="PlaylistActions" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="PlayAll_Click" AutomationProperties.Name="Reproducir todo">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="Reproducir todo" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Content="Eliminar lista" Click="DeleteList_Click" />
                        </StackPanel>
                        <StackPanel x:Name="LibraryActions" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed">
                            <Button Click="ImportLink_Click" AutomationProperties.Name="Importar una lista desde un enlace">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                    <TextBlock Text="Importar" />
                                </StackPanel>
                            </Button>
                            <Button Click="ExportLibrary_Click" AutomationProperties.Name="Exportar la biblioteca a un archivo">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Exportar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="ScopeChips" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="Genres" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="MusicChips" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed" />

                        <!-- Cabecera de la página de un artista -->
                        <StackPanel x:Name="ArtistHeader" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed">
                            <Button Click="ArtistBack_Click" AutomationProperties.Name="Volver a los resultados">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                    <TextBlock Text="Volver" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ArtistPlay" Style="{StaticResource AccentButtonStyle}" Click="ArtistPlay_Click" AutomationProperties.Name="Reproducir las canciones del artista" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="Reproducir" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Destacado -->
                        <Grid x:Name="Hero" Height="300" CornerRadius="26" Visibility="Collapsed">
                            <Border x:Name="HeroTile" />
                            <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.8" RenderTransformOrigin="0.7,0.4">
                                <Image.RenderTransform><ScaleTransform x:Name="HeroScale" ScaleX="1.02" ScaleY="1.02" /></Image.RenderTransform>
                            </Image>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E6000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Rectangle x:Name="HeroSlash" Width="70" Height="460" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,180,0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><SkewTransform AngleX="-18" /></Rectangle.RenderTransform>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop x:Name="SlashA" Color="#00FF4D62" Offset="0" />
                                        <GradientStop x:Name="SlashB" Color="#66FF4D62" Offset="0.5" />
                                        <GradientStop x:Name="SlashC" Color="#00FF4D62" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Bottom" Margin="32" Spacing="6" MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock x:Name="HeroLabel" Foreground="White" Text="NUEVO LANZAMIENTO" FontSize="12" CharacterSpacing="120" Opacity="0.85" />
                                <TextBlock x:Name="HeroTitle" Foreground="White" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HeroSubtitle" Foreground="White" Opacity="0.8" />
                                <Button Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0" Padding="20,8" Click="Hero_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Play" />
                                        <TextBlock Text="Reproducir" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="HeroDots" Orientation="Horizontal" Spacing="6" Margin="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>

                        <!-- Hecho para ti: mezclas a partir de lo que escuchas (historial solo en este PC) -->
                        <StackPanel x:Name="MixesSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Hecho para ti" Style="{StaticResource SectionTitle}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                <StackPanel x:Name="MixesRow" Orientation="Horizontal" Spacing="12" Margin="8,0,0,8" />
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel x:Name="RecentSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Seguir escuchando" Style="{StaticResource SectionTitle}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                <ItemsRepeater x:Name="RecentRepeater" ItemTemplate="{StaticResource TrackCard}" Margin="0,0,0,8">
                                    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="4" /></ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>

                        <TextBlock x:Name="Status" Foreground="#FF8A80" TextWrapping="Wrap" Visibility="Collapsed" />
                        <StackPanel x:Name="AlbumsSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="AlbumsTitle" Text="Discografía" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="AlbumsInfo" Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                <StackPanel x:Name="AlbumsRow" Orientation="Horizontal" Spacing="12" Margin="8,0,0,8" />
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel x:Name="YouTubeSection" Spacing="6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,14,0,2">
                                <TextBlock x:Name="YouTubeTitle" FontSize="22" FontWeight="Bold" Text="YouTube" />
                                <ProgressRing x:Name="YouTubeBusy" IsActive="False" Width="18" Height="18" />
                            </StackPanel>
                            <TextBlock x:Name="YouTubeInfo" Opacity="0.7" Margin="8,0,0,0" />
                            <ItemsRepeater x:Name="YouTubeRepeater" ItemTemplate="{StaticResource VideoCard}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinColumnSpacing="4" MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel x:Name="EntriesSection" Spacing="6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,14,0,2">
                                <TextBlock x:Name="EntriesTitle" FontSize="22" FontWeight="Bold" Text="Álbumes" />
                                <ProgressRing x:Name="EntriesBusy" IsActive="False" Width="18" Height="18" />
                            </StackPanel>
                            <TextBlock x:Name="EntriesInfo" Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap" />
                            <ItemsRepeater x:Name="EntriesRepeater" ItemTemplate="{StaticResource EntryCard}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinColumnSpacing="4" MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel x:Name="ArtistsSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="ArtistsTitle" Text="Artistas de la semana" Style="{StaticResource SectionTitle}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                                <StackPanel x:Name="ArtistsRow" Orientation="Horizontal" Spacing="14" Margin="8,0,0,8" />
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel x:Name="ShelvesHost" Spacing="14" Visibility="Collapsed">
                            <ProgressRing x:Name="ShelvesBusy" IsActive="False" Width="22" Height="22" HorizontalAlignment="Left" Margin="8,0,0,0" />
                            <TextBlock x:Name="ShelvesInfo" Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="SavedSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="SavedTitle" Text="Guardado" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="SavedEmpty" Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="Aún no has guardado nada. Reproduce algo y pulsa el corazón de la barra inferior." />
                            <ItemsRepeater x:Name="SavedRepeater" ItemTemplate="{StaticResource VideoCard}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinColumnSpacing="4" MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- «Tu semana»: se construye en código con el historial de este PC -->
                        <StackPanel x:Name="WeekSection" Spacing="18" Visibility="Collapsed" Margin="8,4,0,0" />

                        <StackPanel x:Name="DownloadsSection" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Descargado" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="DownloadsEmpty" Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="Todavía no has añadido nada. Usa el botón de abajo para añadir tus archivos de música." />
                            <Button Click="AddMusicFiles_Click" Margin="8,0,0,0" AutomationProperties.Name="Añadir mis archivos de música">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Añadir mis archivos de música (MP3…)" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="LocalMusicInfo" Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap" />
                            <StackPanel x:Name="DownloadedHost" Spacing="6" />
                        </StackPanel>

                        <StackPanel x:Name="SettingsSection" Spacing="22" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Left" Margin="8,0,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Aspecto" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ComboBox x:Name="LookBox" Header="Estilo" Width="240" SelectionChanged="Look_Changed" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="CustomColorButton" AutomationProperties.Name="Elegir mi color">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE790;" FontSize="14" />
                                            <TextBlock Text="Elegir mi color…" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                             IsColorChannelTextInputVisible="False" IsHexInputVisible="True" ColorChanged="AccentPicker_ColorChanged" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Border x:Name="CustomSwatch" Width="26" Height="26" CornerRadius="13" BorderThickness="1" BorderBrush="{StaticResource NsLineBrush}" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                                           Text="Cambia colores, brillo y animaciones al momento. «Clásico» es el aspecto de siempre. En «Elegir mi color» puedes poner el color que quieras: el texto de los botones se adapta solo para que siempre se lea." />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Reproducción" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ToggleSwitch x:Name="RadioToggle" Header="Radio automática" OnContent="Activada" OffContent="Desactivada" Toggled="Radio_Toggled" />
                                <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                                           Text="Cuando se acaba la lista, la música no se para: sigue con canciones parecidas a la última (la radio de YouTube Music). Con «Repetir la lista» activado no se añade nada." />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Ecualizador" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="En mantenimiento: se retiró temporalmente mientras se arregla un fallo. Volverá en una próxima versión." />
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Ecualizador" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ToggleSwitch x:Name="EqToggle" Header="Activar ecualizador" OnContent="Activado" OffContent="Desactivado" Toggled="EqToggle_Toggled" />
                                <ComboBox x:Name="EqPresetBox" Header="Ajuste" Width="220" SelectionChanged="EqPreset_Changed" />
                                <StackPanel x:Name="EqBandsHost" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0" />
                                <TextBlock x:Name="EqStatus" Opacity="0.8" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                                           Text="Actúa sobre el sonido de YouTube dentro de la app. Los vídeos del catálogo libre no admiten ecualizador." />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Descargas" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="DownloadFolderText" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Cambiar carpeta" Click="ChangeFolder_Click" />
                                    <Button Content="Abrir carpeta" Click="OpenFolder_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Privacidad" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ToggleSwitch x:Name="AdBlockToggle" Header="Bloquear anuncios y rastreadores" OnContent="Activado" OffContent="Desactivado" Toggled="AdBlock_Toggled" />
                                <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                                           Text="Corta las conexiones a servidores de publicidad conocidos. Los anuncios que YouTube sirve desde sus propios servidores de vídeo pueden seguir apareciendo." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Reproductor oficial de YouTube embebido, controlado por la barra de la app -->
                <Grid x:Name="YouTubeLayer" Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <WebView2 x:Name="YouTubePlayer" Margin="0,56,0,0" />
                    <Button Margin="12" VerticalAlignment="Top" Click="CloseLayer_Click" ToolTipService.ToolTip="Ocultar vídeo (sigue sonando)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Back" />
                            <TextBlock Text="Volver" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Reproductor de vídeo a pantalla completa del área de contenido -->
                <Grid x:Name="VideoLayer" Background="Black" Visibility="Collapsed">
                    <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="False" Stretch="Uniform" />
                    <Button Margin="16" VerticalAlignment="Top" Click="CloseLayer_Click" ToolTipService.ToolTip="Ocultar vídeo (sigue sonando)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Back" />
                            <TextBlock Text="Volver" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Barra de reproducción: se tiñe con el color de la portada que suena -->
        <Grid x:Name="Bar" Grid.Row="2" Margin="12,4,12,12" CornerRadius="24" Padding="14,10,18,10" ColumnSpacing="16"
              Background="{StaticResource NsBarBrush}" BorderBrush="{StaticResource NsLineBrush}" BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Rectangle x:Name="BarTint" Grid.ColumnSpan="3" Margin="-14,-10,-18,-10" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.75,0.5">
                        <GradientStop x:Name="BarTintStop" Color="#38FF4D62" Offset="0" />
                        <GradientStop x:Name="BarTintEnd" Color="#00FF4D62" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="BarLine" Grid.ColumnSpan="3" Height="2" Margin="60,-10,60,0" VerticalAlignment="Top" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop x:Name="BarLineA" Color="#00FF4D62" Offset="0" />
                        <GradientStop x:Name="BarLineB" Color="#CCFF4D62" Offset="0.5" />
                        <GradientStop x:Name="BarLineC" Color="#00FF4D62" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid ColumnSpacing="14" VerticalAlignment="Center" Background="Transparent" Tapped="Now_Tapped"
                  ToolTipService.ToolTip="Abrir «Reproduciendo»">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="58" Height="58">
                    <Rectangle x:Name="NowGlow" Margin="-16" Opacity="0" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush>
                                <GradientStop x:Name="NowGlowStop" Color="#AAFF4D62" Offset="0.35" />
                                <GradientStop x:Name="NowGlowEnd" Color="#00FF4D62" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="NowArtScale" /></Grid.RenderTransform>
                        <Border x:Name="NowTile" Background="#22FFFFFF" />
                        <FontIcon Glyph="&#xE8D6;" FontSize="22" Opacity="0.45" />
                        <Image x:Name="NowImage" Stretch="UniformToFill">
                            <Image.OpacityTransition><ScalarTransition Duration="0:0:0.35" /></Image.OpacityTransition>
                        </Image>
                    </Grid>
                </Grid>
                <StackPanel x:Name="NowText" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel.TranslationTransition><Vector3Transition Duration="0:0:0.3" /></StackPanel.TranslationTransition>
                    <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.3" /></StackPanel.OpacityTransition>
                    <TextBlock x:Name="NowTitle" Text="Nada en reproducción" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowArtist" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel x:Name="PlayingBars" Grid.Column="2" Orientation="Horizontal" Spacing="2" Height="18" VerticalAlignment="Center" Visibility="Collapsed">
                    <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="Bar1" ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="Bar2" ScaleY="0.8" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="Bar3" ScaleY="0.5" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="Bar4" ScaleY="0.7" /></Rectangle.RenderTransform></Rectangle>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" Spacing="0" MaxWidth="720" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button x:Name="ShuffleBtn" Click="Shuffle_Click" Style="{StaticResource BarIcon}" VerticalAlignment="Center" ToolTipService.ToolTip="Aleatorio: desactivado" AutomationProperties.Name="Aleatorio: desactivado">
                        <FontIcon Glyph="&#xE8B1;" FontSize="15" />
                    </Button>
                    <Button Click="Prev_Click" Style="{StaticResource BarIcon}" VerticalAlignment="Center" ToolTipService.ToolTip="Anterior" AutomationProperties.Name="Anterior">
                        <FontIcon Glyph="&#xE892;" FontSize="17" />
                    </Button>
                    <Grid Width="48" Height="48">
                        <Ellipse x:Name="PlayHalo" Fill="{StaticResource NsAccentBrush}" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="PlayHaloScale" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Button Click="Play_Click" Style="{StaticResource AccentButtonStyle}" Width="48" Height="48" CornerRadius="24" Padding="0"
                                ToolTipService.ToolTip="Reproducir / Pausa" AutomationProperties.Name="Reproducir o pausar">
                            <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
                        </Button>
                    </Grid>
                    <Button Click="Next_Click" Style="{StaticResource BarIcon}" VerticalAlignment="Center" ToolTipService.ToolTip="Siguiente" AutomationProperties.Name="Siguiente">
                        <FontIcon Glyph="&#xE893;" FontSize="17" />
                    </Button>
                    <Button x:Name="RepeatBtn" Click="Repeat_Click" Style="{StaticResource BarIcon}" VerticalAlignment="Center" ToolTipService.ToolTip="Repetir: desactivado" AutomationProperties.Name="Repetir: desactivado">
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="15" />
                    </Button>
                </StackPanel>
                <Grid ColumnSpacing="10" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Elapsed" Text="0:00" FontSize="12" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <Slider x:Name="Progress" Grid.Column="1" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False"
                            ValueChanged="Progress_ValueChanged" />
                    <TextBlock x:Name="Total" Grid.Column="2" Text="0:00" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BarIcon}" ToolTipService.ToolTip="Añadir a una lista" AutomationProperties.Name="Añadir a lista">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="PlaylistMenu" Opening="PlaylistMenu_Opening" />
                    </Button.Flyout>
                </Button>
                <Button Click="Save_Click" Style="{StaticResource BarIcon}" ToolTipService.ToolTip="Guardar en Mi biblioteca" AutomationProperties.Name="Guardar">
                    <FontIcon x:Name="SaveIcon" Glyph="&#xEB51;" FontSize="16" />
                </Button>
                <Button Click="Download_Click" Style="{StaticResource BarIcon}" ToolTipService.ToolTip="Descargar (contenido libre)" AutomationProperties.Name="Descargar">
                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                </Button>
                <Button Click="Lyrics_Click" Style="{StaticResource BarIcon}" ToolTipService.ToolTip="Mostrar u ocultar la letra" AutomationProperties.Name="Letra">
                    <FontIcon Glyph="&#xE8D2;" FontSize="16" />
                </Button>
                <Button Click="ShowVideo_Click" Style="{StaticResource BarIcon}" ToolTipService.ToolTip="Mostrar u ocultar el vídeo" AutomationProperties.Name="Mostrar vídeo">
                    <FontIcon Glyph="&#xE714;" FontSize="16" />
                </Button>
                <Button Click="Mini_Click" Style="{StaticResource BarIcon}" ToolTipService.ToolTip="Mini reproductor (siempre visible)" AutomationProperties.Name="Mini reproductor">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15" />
                </Button>
                <Border Width="1" Height="22" Margin="8,0" Background="{StaticResource NsLineBrush}" />
                <FontIcon Glyph="&#xE767;" FontSize="16" Opacity="0.8" />
                <Slider x:Name="Volume" Width="110" Margin="8,0,0,0" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" ValueChanged="Volume_ValueChanged" />
            </StackPanel>
        </Grid>

        <!-- Aviso breve (radio, repetir, aleatorio) encima de la barra -->
        <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Padding="16,9"
                CornerRadius="20" Background="{StaticResource NsBarBrush}" BorderBrush="{StaticResource NsLineBrush}" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False">
            <Border.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Border.OpacityTransition>
            <Border.TranslationTransition><Vector3Transition Duration="0:0:0.25" /></Border.TranslationTransition>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon x:Name="ToastIcon" Glyph="&#xE8D6;" FontSize="15" Foreground="{StaticResource NsAccentBrush}" />
                <TextBlock x:Name="ToastText" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Pantalla «Reproduciendo» -->
        <Grid x:Name="NowSheet" Grid.RowSpan="3" Visibility="Collapsed" Background="{StaticResource NsBgBrush}">
            <!-- Fondo: la portada en muy baja resolución, ampliada (queda desenfocada) y oscurecida -->
            <Image x:Name="NpBackdrop" Stretch="UniformToFill" Opacity="0.5" IsHitTestVisible="False" />
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop x:Name="NpShadeTop" Color="#660B0C10" Offset="0" />
                        <GradientStop x:Name="NpShadeBottom" Color="#F20B0C10" Offset="0.85" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.75">
                        <GradientStop x:Name="NpGlowStop" Color="#66FF4D62" Offset="0" />
                        <GradientStop x:Name="NpGlowEnd" Color="#00FF4D62" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,48,0,0" Width="44" Height="44" CornerRadius="22" Padding="0"
                    Click="NowSheetClose_Click" AutomationProperties.Name="Cerrar">
                <FontIcon Glyph="&#xE70D;" />
            </Button>
            <Grid x:Name="NpLayout" Margin="0,40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="NpLyricsCol" Width="0" />
                </Grid.ColumnDefinitions>
            <StackPanel x:Name="NpMain" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="560" Padding="24">
                <Grid Width="340" Height="340" HorizontalAlignment="Center">
                    <Rectangle Margin="-70" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <RadialGradientBrush>
                                <GradientStop x:Name="NpArtGlowStop" Color="#88FF4D62" Offset="0.3" />
                                <GradientStop x:Name="NpArtGlowEnd" Color="#00FF4D62" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border CornerRadius="28" Background="{StaticResource NsPanelBrush}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="NpArtScale" /></Border.RenderTransform>
                        <Image x:Name="NpImage" Stretch="UniformToFill" />
                    </Border>
                </Grid>
                <TextBlock x:Name="NpTitle" FontSize="26" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
                <TextBlock x:Name="NpArtist" Opacity="0.7" TextAlignment="Center" />
                <Slider x:Name="NpProgress" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False" ValueChanged="Progress_ValueChanged" Margin="0,10,0,0" />
                <Grid>
                    <TextBlock x:Name="NpElapsed" Text="0:00" FontSize="12" Opacity="0.7" />
                    <TextBlock x:Name="NpTotal" Text="0:00" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                    <Button x:Name="NpShuffleBtn" Click="Shuffle_Click" Background="Transparent" BorderThickness="0" Width="48" Height="48" CornerRadius="24" AutomationProperties.Name="Aleatorio: desactivado"><FontIcon Glyph="&#xE8B1;" FontSize="18" /></Button>
                    <Button Click="Prev_Click" Background="Transparent" BorderThickness="0" Width="56" Height="56" CornerRadius="28" AutomationProperties.Name="Anterior"><FontIcon Glyph="&#xE892;" FontSize="22" /></Button>
                    <Button Click="Play_Click" Style="{StaticResource AccentButtonStyle}" Width="72" Height="72" CornerRadius="36" Padding="0" AutomationProperties.Name="Reproducir o pausar"><SymbolIcon x:Name="NpPlayIcon" Symbol="Play" /></Button>
                    <Button Click="Next_Click" Background="Transparent" BorderThickness="0" Width="56" Height="56" CornerRadius="28" AutomationProperties.Name="Siguiente"><FontIcon Glyph="&#xE893;" FontSize="22" /></Button>
                    <Button x:Name="NpRepeatBtn" Click="Repeat_Click" Background="Transparent" BorderThickness="0" Width="48" Height="48" CornerRadius="24" AutomationProperties.Name="Repetir: desactivado"><FontIcon x:Name="NpRepeatIcon" Glyph="&#xE8EE;" FontSize="18" /></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Click="Save_Click" CornerRadius="14" MinWidth="56" MinHeight="46" AutomationProperties.Name="Guardar"><FontIcon x:Name="NpHeartIcon" Glyph="&#xEB51;" /></Button>
                    <Button CornerRadius="14" MinWidth="56" MinHeight="46" AutomationProperties.Name="Añadir a lista">
                        <SymbolIcon Symbol="Add" />
                        <Button.Flyout><MenuFlyout x:Name="PlaylistMenu2" Opening="PlaylistMenu_Opening" /></Button.Flyout>
                    </Button>
                    <Button Click="Queue_Click" Content="Cola" CornerRadius="14" MinWidth="56" MinHeight="46" />
                    <ToggleButton x:Name="NpLyricsToggle" Click="NowSheetLyrics_Click" Content="Letra" CornerRadius="14" MinWidth="56" MinHeight="46" AutomationProperties.Name="Letra a pantalla completa" />
                    <Button Click="NowSheetVideo_Click" CornerRadius="14" MinWidth="56" MinHeight="46" AutomationProperties.Name="Mostrar vídeo"><SymbolIcon Symbol="SlideShow" /></Button>
                </StackPanel>
            </StackPanel>

            <!-- Letra a pantalla completa (tipo karaoke): la línea que suena, grande; las demás, apagadas. Pulsar una línea salta a ella -->
            <Grid x:Name="NpLyricsHost" Grid.Column="1" Visibility="Collapsed" Margin="0,0,48,24">
                <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.3" /></Grid.OpacityTransition>
                <ScrollViewer x:Name="NpLyricsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="NpLyricsLines" Spacing="18" Padding="8,260,24,420" />
                </ScrollViewer>
                <TextBlock x:Name="NpLyricsInfo" FontSize="20" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,24,0" />
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
